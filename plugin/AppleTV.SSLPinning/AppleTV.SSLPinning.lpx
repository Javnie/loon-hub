#!name = TV SSL Pinning Workaround
#!desc = 绕过 Apple TV 播放列表域名的 SSL 证书固定，配合 DualSubs 恢复双语字幕。摘自 NSRingo/TV 的 isWorkaroundSSLPinning。
#!author = NSRingo/VirgilClyne (extracted)
#!homepage = https://github.com/Javnie/loon-hub
#!icon = https://developer.apple.com/assets/elements/icons/apple-tv/apple-tv-128x128.png
#!tag = DualSubs, Apple TV
#!system = iOS,iPadOS,tvOS,macOS
#!date = 2026-08-20 12:50:00
#!version = 1.0.0

[Script]
http-response ^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/ script-path=https://raw.githubusercontent.com/Javnie/loon-hub/main/plugin/AppleTV.SSLPinning/response.js, requires-body=1, timeout=30, tag=TV.SSLPinning.response

[Rewrite]
# App 访问未固定的别名；Loon 把请求转回 Apple 真实播放域名，path/query 保留
^https?:\/\/play-cdn\.itunes\.apple\.com header https://play.itunes.apple.com
^https?:\/\/play-edge-cdn\.itunes\.apple\.com header https://play-edge.itunes.apple.com

[MITM]
# 不要加入 play.itunes.apple.com / play-edge.itunes.apple.com，这两个有证书固定
hostname = uts-api.itunes.apple.com, play-cdn.itunes.apple.com, play-edge-cdn.itunes.apple.com
